{%- from "macros.njk" import dib -%}
{%- set secp = contenido.paginas.secciones.proyectos -%}
<section class="seccion seccion--gris" aria-labelledby="proyectos-titulo">
  <div class="contenedor dos-col">
    <div>
      <svg class="dib gira-1" style="width:5rem;height:5rem;margin-bottom:1.5rem" aria-hidden="true"><use href="#d-area-proyectos"/></svg>
      <h2 class="encabezado__titulo" id="proyectos-titulo">{{ secp.titulo }}</h2>
      <p class="encabezado__bajada">{{ secp.bajada }}</p>
    </div>
    <div>
      {%- if contenido.proyectos.length %}
      <ul class="renglones">
        {%- for pr in contenido.proyectos.slice(0, 4) %}
        <li class="renglon" style="grid-template-columns:minmax(0,1fr) auto">
          <div>
            <h3 class="renglon__titulo"><a href="{{ pr.url }}">{{ pr.nombre }}</a></h3>
            {% if pr.descripcion %}<p class="renglon__desc">{{ pr.descripcion }}</p>{% endif %}
            <div class="renglon__meta">
              {% if pr.anio %}<span class="sticker sticker--recto">{{ pr.anio }}</span>{% endif %}
              {% if pr.estado %}<span class="sticker sticker--contorno sticker--recto">{{ pr.estado }}</span>{% endif %}
              {% if pr.institucion %}<span class="sticker sticker--gris sticker--recto">{{ pr.institucion }}</span>{% endif %}
            </div>
          </div>
        </li>
        {%- endfor %}
      </ul>
      <p class="mt-2"><a class="enlace-flecha" href="/quienes-somos/proyectos/"><span>Ver todos los proyectos</span>{{ dib("flecha") }}</a></p>
      {%- else %}
      <p class="pendiente" style="font-size:1.3rem">Los proyectos se van a presentar en esta sección.</p>
      {%- endif %}
    </div>
  </div>
</section>
